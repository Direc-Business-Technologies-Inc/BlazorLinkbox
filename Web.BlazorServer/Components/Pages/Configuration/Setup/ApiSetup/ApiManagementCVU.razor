@using Web.BlazorServer.Components.Security
@using Web.BlazorServer.ViewModels.Configuration.Setup.Api
@using Web.BlazorServer.Components.Shared.Skeletons

@inherits BaseForm<ApiSetupVM>
@page "/configuration/setup/api-setup/create"
@page "/configuration/setup/api-setup/view"
@page "/configuration/setup/api-setup/update"
@layout ProtectedLayout
@attribute [AppAuthorizationAttribute("VIEW", "OAPS")]

<PageTitle>@(Creating ? "New" : Updating ? "Updating" : string.Empty) API @(Viewing || Updating ? FormData.ApiCode : string.Empty)</PageTitle>

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" class="rz-mb-4">
    <AppBreadCrumbs ModuleCode="OAPS" />
</RadzenStack>
<AppContent>
    <AppFormSkeleton TItem="ApiSetupVM" Loading=@IsLoadingData />
    <RadzenStack Visible="@(!IsLoadingData)" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="8px" class="rz-mb-2">
        <RadzenBadge BadgeStyle="@(Creating? BadgeStyle.Success: FormData.Active? BadgeStyle.Success: BadgeStyle.Base)" Text="@(Creating ? "New" : FormData.Active ? "Active" : "Inactive")" />
        |
        <RadzenText Text="@(string.IsNullOrEmpty(FormData.ApiCode) ? "LinkBox API Setup" : FormData.ApiCode)" />
        |
        <RadzenText Text="@FormData.CreatedDate.ToString("MMM dd, yyyy")" />
    </RadzenStack>
    <RadzenTemplateForm Visible="@(!IsLoadingData)" @ref="@TemplateForm" TItem="ApiSetupVM" @bind-Data="@FormData" EditContext="@EditContext" Submit="HandleSubmit">
        <RadzenStack Gap="1rem">
            <RadzenRow>
                <RadzenColumn Size="12" SizeMD="12">
                    <RadzenFieldset AllowCollapse Text="API Configuration">
                        <ChildContent>
                            <RadzenRow>
                                <RadzenColumn Size="12" SizeMD="2">
                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="8px" class="rz-h-100">
                                        <RadzenSwitch ReadOnly="@(Viewing)" @bind-Value="@FormData.Active" />
                                        <RadzenText class="rz-m-0" TextStyle="TextStyle.Subtitle2" Text="@(FormData.Active ? "Active" : "Inactive")" />
                                    </RadzenStack>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="5">
                                    <RadzenFormField Text="API Code *" class="rz-w-100">
                                        <ChildContent>
                                            <RadzenTextBox ReadOnly="@Viewing" @bind-Value="@FormData.ApiCode" Name="as_apicode" Disabled="@IsBusy" class="rz-w-100" />
                                        </ChildContent>
                                        <Helper>
                                            <RadzenRequiredValidator Component="as_apicode" Text="API Code is required" />
                                        </Helper>
                                    </RadzenFormField>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="5">
                                    <RadzenFormField Text="Module *" class="rz-w-100">
                                        <ChildContent>
                                            <RadzenDropDown ReadOnly="@Viewing" @bind-Value="@FormData.Module" Data=@Module Name="as_module" Disabled="@IsBusy" class="rz-w-100" />
                                        </ChildContent>
                                        <Helper>
                                            <RadzenRequiredValidator Component="as_module" Text="Module is required" />
                                        </Helper>
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>
                            <RadzenRow>
                                <RadzenColumn Size="12" SizeMD="2" class="rz-pt-3">
                                    <RadzenButton Text="Show Other Options" 
                                                  Click="HandleSidebar" 
                                                  ButtonStyle="ButtonStyle.Base"
                                                  Shade="Shade.Lighter"
                                                  Variant="Variant.Flat" 
                                                  class="rz-border-radius-6"/>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="5">
                                    <RadzenFormField Text="Method *" class="rz-w-100">
                                        <ChildContent>
                                            <RadzenDropDown ReadOnly="@Viewing" @bind-Value="@FormData.Method" Data=@Method Name="as_method" Disabled="@IsBusy" class="rz-w-100" />
                                        </ChildContent>
                                        <Helper>
                                            <RadzenRequiredValidator Component="as_method" Text="Method is required" />
                                        </Helper>
                                    </RadzenFormField>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="5">
                                    <RadzenFormField Text="URL *" class="rz-w-100">
                                        <ChildContent>
                                            <RadzenTextBox ReadOnly="@Viewing" @bind-Value="@FormData.Url" Name="as_url" Disabled="@IsBusy" class="rz-w-100" />
                                        </ChildContent>
                                        <Helper>
                                            <RadzenRequiredValidator Component="as_url" Text="URL is required" />
                                        </Helper>
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow> 
                        </ChildContent>
                    </RadzenFieldset>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn>
                    <RadzenStack class="rz-mt-8" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                        <RadzenButton Text="Back" ButtonStyle="ButtonStyle.Base" Click="@Return" />
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="16px">
                            <RadzenButton Visible="@(Updating && Can.Update("OPTS"))" Text="Cancel Edit" ButtonStyle="ButtonStyle.Base" Click="@CancelEditing" />
                            <RadzenButton Visible="@(Viewing && Can.Update("OPTS"))" Text="Edit" ButtonStyle="ButtonStyle.Success" Click="@InitializeEditing" />
                            <RadzenButton Visible="@((Creating && Can.Create("OPTS")) || (Updating && Can.Update("OPTS")))" ButtonStyle="ButtonStyle.Success" ButtonType="ButtonType.Submit">
                                Save @(Updating ? "Changes" : string.Empty)
                            </RadzenButton>
                        </RadzenStack>
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
        </RadzenStack>
    </RadzenTemplateForm>
</AppContent>

@code {
    // Move to Enum later
    List<string> Method = new List<string>
    {
        "POST",
        "GET",
        "PUT",
        "DELETE"
    };

    List<string> Module = new List<string>
    {
        "NA",
        "Sales Order",
        "AR Invoice",
        "Incoming Payment",
        "Item Master Data"
    };
}