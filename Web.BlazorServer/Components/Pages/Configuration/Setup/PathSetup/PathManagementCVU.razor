@using Web.BlazorServer.Components.Security
@using Web.BlazorServer.ViewModels.Configuration.Setup.Path
@using Web.BlazorServer.Components.Shared.Skeletons

@inherits BaseForm<PathSetupVM>
@page "/configuration/setup/path-setup/create"
@page "/configuration/setup/path-setup/view"
@page "/configuration/setup/path-setup/update"
@layout ProtectedLayout
@attribute [AppAuthorizationAttribute("VIEW", "OPTS")]

<PageTitle>@(Creating ? "New" : Updating ? "Updating" : string.Empty) Path @(Viewing || Updating ? FormData.PathCode : string.Empty)</PageTitle>

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" class="rz-mb-4">
    <AppBreadCrumbs ModuleCode="OPTS" />
</RadzenStack>
<AppContent>
    <AppFormSkeleton TItem="PathSetupVM" Loading=@IsLoadingData />
    <RadzenStack Visible="@(!IsLoadingData)" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="8px" class="rz-mb-2">
        <RadzenBadge BadgeStyle="@(Creating? BadgeStyle.Success: FormData.Active? BadgeStyle.Success: BadgeStyle.Base)" Text="@(Creating ? "New" : FormData.Active ? "Active" : "Inactive")" />
        |
        <RadzenText Text="@(string.IsNullOrEmpty(FormData.PathCode) ? "LinkBox Path Setup" : FormData.PathCode)" />
        |
        <RadzenText Text="@FormData.CreatedDate.ToString("MMM dd, yyyy")" />
    </RadzenStack>
    <RadzenTemplateForm Visible="@(!IsLoadingData)" @ref="@TemplateForm" TItem="PathSetupVM" @bind-Data="@FormData" EditContext="@EditContext" Submit="HandleSubmit">
        <RadzenStack Gap="1rem">
            <RadzenRow>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenFieldset AllowCollapse Text="Local Configuration">
                        <ChildContent>
                            <RadzenRow>
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="Path Code *" class="rz-w-100">
                                        <ChildContent>
                                            <RadzenTextBox ReadOnly="@Viewing" @bind-Value="@FormData.PathCode" Name="ps_pathcode" Disabled="@IsBusy" class="rz-w-100" />
                                        </ChildContent>
                                        <Helper>
                                            <RadzenRequiredValidator Component="ps_pathcode" Text="Path Code is required" />
                                        </Helper>
                                    </RadzenFormField>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="8px" class="rz-h-100">
                                        <RadzenSwitch ReadOnly="@(Viewing)" @bind-Value="@FormData.Active" />
                                        <RadzenText class="rz-m-0" TextStyle="TextStyle.Subtitle2" Text="@(FormData.Active ? "Active" : "Inactive")" />
                                    </RadzenStack>
                                </RadzenColumn>
                            </RadzenRow>
                            <RadzenRow>
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="Local Path *" class="rz-w-100">
                                        <ChildContent>
                                            <RadzenTextBox ReadOnly="@Viewing" @bind-Value="@FormData.LocalPath" Name="ps_localpath" Disabled="@IsBusy" class="rz-w-100" />
                                        </ChildContent>
                                        <Helper>
                                            <RadzenRequiredValidator Component="ps_localpath" Text="Local Path is required" />
                                        </Helper>
                                    </RadzenFormField>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="File Search Option *" class="rz-w-100">
                                        <ChildContent>
                                            <RadzenTextBox ReadOnly="@Viewing" @bind-Value="@FormData.FileSearchOption" Name="ps_filesearch" Disabled="@IsBusy" class="rz-w-100" />
                                        </ChildContent>
                                        <Helper>
                                            <RadzenRequiredValidator Component="ps_filesearch" Text="File search option is required" />
                                        </Helper>
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>
                            <RadzenRow>
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="Backup Path" class="rz-w-100">
                                        <ChildContent>
                                            <RadzenTextBox ReadOnly="@Viewing" @bind-Value="@FormData.BackupPath" Disabled="@IsBusy" class="rz-w-100" />
                                        </ChildContent>
                                    </RadzenFormField>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="Error Path" class="rz-w-100">
                                        <ChildContent>
                                            <RadzenTextBox ReadOnly="@Viewing" @bind-Value="@FormData.ErrorPath" Disabled="@IsBusy" class="rz-w-100" />
                                        </ChildContent>
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>
                        </ChildContent>
                    </RadzenFieldset>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenFieldset AllowCollapse Text="Remote Server">
                        <ChildContent>
                            <RadzenRow>
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="Remote Path" class="rz-w-100">
                                        <ChildContent>
                                            <RadzenTextBox ReadOnly="@Viewing" @bind-Value="@FormData.RemotePath" Disabled="@IsBusy" class="rz-w-100" />
                                        </ChildContent>
                                    </RadzenFormField>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="Remote Server" class="rz-w-100">
                                        <ChildContent>
                                            <RadzenTextBox ReadOnly="@Viewing" @bind-Value="@FormData.RemoteServer" Disabled="@IsBusy" class="rz-w-100" />
                                        </ChildContent>
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>
                            <RadzenRow>
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="Remote IP Address" class="rz-w-100">
                                        <ChildContent>
                                            <RadzenMask Mask="***.**.**.**"
                                                        CharacterPattern="[0-9]"
                                                        ReadOnly="@Viewing"
                                                        @bind-Value=@FormData.RemoteIpAddress
                                                        Disabled="@IsBusy"
                                                        class="rz-w-100" />
                                        </ChildContent>
                                    </RadzenFormField>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="Remote Port" class="rz-w-100">
                                        <ChildContent>
                                            <RadzenMask Mask="*****"
                                                        CharacterPattern="[0-9]"
                                                        ReadOnly="@Viewing"
                                                        @bind-Value=@FormData.RemotePort
                                                        Disabled="@IsBusy"
                                                        class="rz-w-100" />
                                        </ChildContent>
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>
                            <RadzenRow>
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="Remote User ID" class="rz-w-100">
                                        <ChildContent>
                                            <RadzenTextBox ReadOnly="@Viewing" @bind-Value="@FormData.RemoteUserId" Disabled="@IsBusy" class="rz-w-100" />
                                        </ChildContent>
                                    </RadzenFormField>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="Remote Password" class="rz-w-100">
                                        <ChildContent>
                                            <RadzenPassword Visible="@(!PasswordVisibility)" ReadOnly="@Viewing" @bind-Value="@FormData.RemotePassword" Name="user_password_h" Disabled="@IsBusy" class="rz-w-100" />
                                            <RadzenTextBox Visible="@PasswordVisibility" ReadOnly="@Viewing" @bind-Value="@FormData.RemotePassword" Name="user_password_v" Disabled="@IsBusy" class="rz-w-100" />
                                        </ChildContent>
                                        <End>
                                            <RadzenButton Icon="@(PasswordVisibility ? "visibility_off" : "visibility")" Size="ButtonSize.ExtraSmall" Click="@ToggleVisibility" />
                                        </End>
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>
                            <RadzenRow class="rz-pt-2">
                                <RadzenLabel Text="*If the path points outside the addon server, please complete this section accurately." class="rz-color-base-600" Style="font-weight: 400;" />
                            </RadzenRow>
                        </ChildContent>
                    </RadzenFieldset>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn>
                    <RadzenStack class="rz-mt-8" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                        <RadzenButton Text="Back" ButtonStyle="ButtonStyle.Base" Click="@Return" />
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="16px">
                            <RadzenButton Visible="@(Updating && Can.Update("OPTS"))" Text="Cancel Edit" ButtonStyle="ButtonStyle.Base" Click="@CancelEditing" />
                            <RadzenButton Visible="@(Viewing && Can.Update("OPTS"))" Text="Edit" ButtonStyle="ButtonStyle.Success" Click="@InitializeEditing" />
                            <RadzenButton Visible="@((Creating && Can.Create("OPTS")) || (Updating && Can.Update("OPTS")))" ButtonStyle="ButtonStyle.Success" ButtonType="ButtonType.Submit">
                                Save @(Updating ? "Changes" : string.Empty)
                            </RadzenButton>
                        </RadzenStack>
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
        </RadzenStack>
    </RadzenTemplateForm>
</AppContent>
