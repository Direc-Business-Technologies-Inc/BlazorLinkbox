@using Web.BlazorServer.Components.Security
@using Web.BlazorServer.ViewModels.Configuration.Setup.Email
@using Web.BlazorServer.Components.Shared.Skeletons

@inherits BaseForm<EmailSetupVM>
@page "/configuration/setup/email-setup/create"
@page "/configuration/setup/email-setup/view"
@page "/configuration/setup/email-setup/update"
@layout ProtectedLayout
@attribute [AppAuthorizationAttribute("VIEW", "OEMS")]

<PageTitle>@(Creating ? "New" : Updating ? "Updating" : string.Empty) Email @(Viewing || Updating ? FormData.EmailCode : string.Empty)</PageTitle>

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" class="rz-mb-4">
    <AppBreadCrumbs ModuleCode="OEMS" />
</RadzenStack>
<AppContent>
    <AppFormSkeleton TItem="EmailSetupVM" Loading=@IsLoadingData />
    <RadzenStack Visible="@(!IsLoadingData)" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="8px" class="rz-mb-2">
        <RadzenBadge BadgeStyle="@(Creating? BadgeStyle.Success: FormData.Active? BadgeStyle.Success: BadgeStyle.Base)" Text="@(Creating ? "New" : FormData.Active ? "Active" : "Inactive")" />
        |
        <RadzenText Text="@(string.IsNullOrEmpty(FormData.EmailCode) ? "LinkBox Email Setup" : FormData.EmailCode)" />
        |
        <RadzenText Text="@FormData.CreatedDate.ToString("MMM dd, yyyy")" />
    </RadzenStack>
    <RadzenTemplateForm Visible="@(!IsLoadingData)" @ref="@TemplateForm" TItem="EmailSetupVM" @bind-Data="@FormData" EditContext="@EditContext" Submit="HandleSubmit">
        <RadzenStack Gap="1rem">
            <RadzenRow>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenFieldset AllowCollapse Text="Email Details">
                        <ChildContent>
                            <RadzenRow>
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="Email Code *" class="rz-w-100">
                                        <ChildContent>
                                            <RadzenTextBox ReadOnly="@Viewing" @bind-Value="@FormData.EmailCode" Name="es_emailcode" Disabled="@IsBusy" class="rz-w-100" />
                                        </ChildContent>
                                        <Helper>
                                            <RadzenRequiredValidator Component="es_emailcode" Text="Email Code is required" />
                                        </Helper>
                                    </RadzenFormField>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="8px" class="rz-h-100">
                                        <RadzenSwitch ReadOnly="@(Viewing)" @bind-Value="@FormData.Active" />
                                        <RadzenText class="rz-m-0" TextStyle="TextStyle.Subtitle2" Text="@(FormData.Active ? "Active" : "Inactive")" />
                                    </RadzenStack>
                                </RadzenColumn>
                            </RadzenRow>
                            <RadzenRow>
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="Display Name *" class="rz-w-100">
                                        <ChildContent>
                                            <RadzenTextBox ReadOnly="@Viewing" @bind-Value="@FormData.DisplayName" Name="es_displayname" Disabled="@IsBusy" class="rz-w-100" />
                                        </ChildContent>
                                        <Helper>
                                            <RadzenRequiredValidator Component="es_displayname" Text="Display Name is required" />
                                        </Helper>
                                    </RadzenFormField>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="Description *" class="rz-w-100">
                                        <ChildContent>
                                            <RadzenTextBox ReadOnly="@Viewing" @bind-Value="@FormData.Description" Name="es_description" Disabled="@IsBusy" class="rz-w-100" />
                                        </ChildContent>
                                        <Helper>
                                            <RadzenRequiredValidator Component="es_description" Text="Description is required" />
                                        </Helper>
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>
                        </ChildContent>
                    </RadzenFieldset>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenFieldset AllowCollapse Text="Email Configuration">
                        <ChildContent>
                            <RadzenRow>
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="SMTP Client *" class="rz-w-100">
                                        <ChildContent>
                                            <RadzenTextBox ReadOnly="@Viewing" @bind-Value="@FormData.SMTPClient" Name="es_smtpclient" Disabled="@IsBusy" class="rz-w-100" />
                                        </ChildContent>
                                        <Helper>
                                            <RadzenRequiredValidator Component="es_smtpclient" Text="SMTP Client is required" />
                                        </Helper>
                                    </RadzenFormField>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="Remote Port" class="rz-w-100">
                                        <ChildContent>
                                            <RadzenMask Mask="*****"
                                                        CharacterPattern="[0-9]"
                                                        ReadOnly="@Viewing"
                                                        @bind-Value=@FormData.Port
                                                        Disabled="@IsBusy"
                                                        class="rz-w-100" />
                                        </ChildContent>
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>
                            <RadzenRow>
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="Email Address" class="rz-w-100">
                                        <ChildContent>
                                            <RadzenTextBox ReadOnly="@Viewing" @bind-Value="@FormData.EmailAddress" Name="es_emailaddress" Disabled="@IsBusy" class="rz-w-100" />
                                        </ChildContent>
                                        <Helper>
                                            <RadzenRequiredValidator Component="es_emailaddress" Text="Email Address is required" />
                                            <RadzenEmailValidator Component="es_emailaddress" Text="Email Address format is incorrect" />
                                        </Helper>
                                    </RadzenFormField>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="Email Password" class="rz-w-100">
                                        <ChildContent>
                                            <RadzenPassword Visible="@(!PasswordVisibility)" ReadOnly="@Viewing" @bind-Value="@FormData.EmailPassword" Name="es_password_h" Disabled="@IsBusy" class="rz-w-100" />
                                            <RadzenTextBox Visible="@PasswordVisibility" ReadOnly="@Viewing" @bind-Value="@FormData.EmailPassword" Name="es_password_v" Disabled="@IsBusy" class="rz-w-100" />
                                        </ChildContent>
                                        <End>
                                            <RadzenButton Icon="@(PasswordVisibility ? "visibility_off" : "visibility")" Size="ButtonSize.ExtraSmall" Click="@ToggleVisibility" />
                                        </End>
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>
                        </ChildContent>
                    </RadzenFieldset>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn>
                    <RadzenStack class="rz-mt-8" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                        <RadzenButton Text="Back" ButtonStyle="ButtonStyle.Base" Click="@Return" />
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="16px">
                            <RadzenButton Visible="@(Updating && Can.Update("OEMS"))" Text="Cancel Edit" ButtonStyle="ButtonStyle.Base" Click="@CancelEditing" />
                            <RadzenButton Visible="@(Viewing && Can.Update("OEMS"))" Text="Edit" ButtonStyle="ButtonStyle.Success" Click="@InitializeEditing" />
                            <RadzenButton Visible="@((Creating && Can.Create("OEMS")) || (Updating && Can.Update("OEMS")))" ButtonStyle="ButtonStyle.Success" ButtonType="ButtonType.Submit">
                                Save @(Updating ? "Changes" : string.Empty)
                            </RadzenButton>
                        </RadzenStack>
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
        </RadzenStack>
    </RadzenTemplateForm>
</AppContent>

@code {

}
