@using Web.BlazorServer.Components.Security
@using Web.BlazorServer.ViewModels.Configuration.Setup.Email

@inherits BaseComponent
@page "/configuration/setup/email-setup"
@layout ProtectedLayout
@attribute [AppAuthorizationAttribute("VIEW", "OEMS")]

<PageTitle>Email Setup</PageTitle>

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" class="rz-mb-4">
    <AppBreadCrumbs ModuleCode="OEMS" />
</RadzenStack>
<AppContent>
    <AppDataGrid @ref="@EmailsDataGrid" Id="Emails_grid" TItem="EmailDataGridVM" DataGetter="@LoadDataAsync" GridSettings="@EmailsDataGridSettings" @bind-GridSettingsLoaded=@GridSettingsLoaded ActionName="@ActionGetEmails">
        <HeaderTemplate>
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" AlignItems="AlignItems.Center" Gap="8px">
                <RadzenButton Icon="settings" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@OpenTableSettings" />
                <RadzenButton Icon="sync" Size="ButtonSize.Small" Click="EmailsDataGrid.ReloadDataAsync" />
                <RadzenButton Visible="@Can.Create("OPTS")" Icon="add" Size=ButtonSize.Small ButtonStyle="ButtonStyle.Success" Shade="Shade.Light" Click="@CreateEmail" />
            </RadzenStack>
        </HeaderTemplate>
        <Columns>
            <RadzenDataGridColumn TItem="EmailDataGridVM"
                                  Property="@nameof(EmailDataGridVM.EmailCode)"
                                  Type="@typeof(string)"
                                  Title="Code" />
            <RadzenDataGridColumn TItem="EmailDataGridVM"
                                  Property="@nameof(EmailDataGridVM.Description)"
                                  Type="@typeof(string)"
                                  Title="Description" />
            <RadzenDataGridColumn TItem="EmailDataGridVM"
                                  Property="@nameof(EmailDataGridVM.Active)"
                                  Type="@typeof(bool)"
                                  Title="Status">
                <Template Context="data">
                    <RadzenBadge BadgeStyle="@(data.Active? BadgeStyle.Success: BadgeStyle.Base)" Text="@(data.Active ? "Active" : "Inactive")" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="EmailDataGridVM"
                                  Type="@typeof(bool)"
                                  Frozen
                                  FrozenPosition="FrozenColumnPosition.Right"
                                  Width="70px"
                                  MaxWidth="70px"
                                  Pickable="false" Sortable="false" Filterable="false">
                <Template Context="data">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceEvenly">
                        <RadzenButton Icon="arrow_right_alt" Size="ButtonSize.ExtraSmall" Click="() => ViewEmail(data)" />
                    </RadzenStack>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </AppDataGrid>
</AppContent>

@code {
    async Task OpenTableSettings()
    {
        await DialogService.OpenAsync(
            "Table Settings",
            ds => @<AppGridSettings TItem="EmailDataGridVM"
            @bind-Grid=@EmailsDataGrid.DataGrid
            @bind-GridSettings=@EmailsDataGridSettings />,
            options: GridSettingsService.GetDialogOptions());

        await EmailsDataGrid.DataGrid.Reload();
    }
}
